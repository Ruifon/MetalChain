# Copie para .env.local apenas se quiser mudar algum valor.
# Sem nenhum arquivo .env, a interface usa o contrato publicado na Sepolia.

# Endereço do contrato MetalChain
VITE_CONTRATO=0xB112dc8970Fa8C27beA660f11F7B34B2Fbde1cB7

# Nós usados para LEITURA (consulta pública, sem carteira), separados por
# vírgula: se o primeiro falhar, usa o próximo. Este endereço fica visível no
# navegador, então nunca coloque aqui a chave privada da carteira.
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.drpc.org

# Rede (11155111 = Sepolia)
VITE_CHAIN_ID=11155111
VITE_REDE_NOME=Sepolia
VITE_EXPLORER=https://sepolia.etherscan.io

# Bloco a partir do qual procurar eventos (antes da publicação do contrato)
VITE_BLOCO_INICIAL=11913380
