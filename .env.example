# Copie este arquivo para ".env" e preencha. NUNCA publique o .env.

# URL RPC da rede Sepolia (Alchemy, Infura ou outro provedor)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/SUA_CHAVE

# Chave privada de uma carteira EXCLUSIVA DE TESTES (nunca a da carteira principal)
PRIVATE_KEY=0xSUA_CHAVE_PRIVADA_DE_TESTE

# Opcional: para verificar o código-fonte no Etherscan
ETHERSCAN_API_KEY=

# Nome gravado para a carteira administradora
NOME_INDUSTRIA=Indústria Demonstração Ltda

# Opcional: credencia um operador logo após a publicação
OPERADOR_CARTEIRA=
OPERADOR_NOME=Transformadora Exemplo S.A.

# Endereço do contrato já publicado (usado por scripts/cenarios-sepolia.js)
CONTRATO_ENDERECO=
